{
  "name": "@skill-recorder/render",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "skill-render": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo no lint",
    "build": "esbuild bin/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/cli.js --banner:js='#!/usr/bin/env node' && chmod +x dist/cli.js",
    "parity": "tsx tests/cli-parity.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@skill-recorder/types": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3"
  }
}
