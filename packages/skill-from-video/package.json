{
  "name": "@skill-recorder/from-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./backend-anthropic": {
      "types": "./src/backend-anthropic.ts",
      "import": "./src/backend-anthropic.ts"
    },
    "./backend-claude-cli": {
      "types": "./src/backend-claude-cli.ts",
      "import": "./src/backend-claude-cli.ts"
    }
  },
  "bin": {
    "skill-from-video": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo no lint",
    "build": "esbuild bin/skill-from-video.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/cli.js --banner:js='#!/usr/bin/env node' --external:@anthropic-ai/sdk --external:youtube-transcript --external:zod --external:zod-to-json-schema && chmod +x dist/cli.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@skill-recorder/types": "workspace:*",
    "@skill-recorder/render": "workspace:*",
    "youtube-transcript": "^1.2.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3"
  }
}
