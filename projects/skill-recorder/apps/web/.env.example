NEXT_PUBLIC_SITE_URL=https://skill-recorder.dev
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_CHROME_WEBSTORE_URL=https://chrome.google.com/webstore/detail/skill-recorder
NEXT_PUBLIC_GITHUB_URL=https://github.com/neo-start/skill-recorder

# Required for `pnpm deploy` (scripts/deploy.sh → wrangler pages deploy).
# Get a token at https://dash.cloudflare.com/profile/api-tokens — grant
# "Cloudflare Pages: Edit" + "Account: Read".
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional: override the Cloudflare Pages project name (defaults to skill-recorder).
PAGES_PROJECT_NAME=skill-recorder
