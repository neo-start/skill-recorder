{
  "name": "@skill-recorder/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx dev-server.ts",
    "dev:worker": "wrangler dev --config _future/wrangler.toml",
