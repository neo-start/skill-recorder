{
  "name": "@skill-recorder/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-playground.mjs && node scripts/middleware-toggle.mjs enabled && next dev -p 3300",
    "build": "node scripts/sync-playground.mjs && node scripts/middleware-toggle.mjs disabled && next build && node scripts/postbuild.mjs",
    "start": "next start -p 3300",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "pages:dev": "wrangler pages dev out --compatibility-date=2026-04-01",
    "deploy": "./scripts/deploy.sh",
    "clean": "rimraf .next out .turbo"
  },
  "dependencies": {
    "@skill-recorder/render": "workspace:*",
    "@skill-recorder/types": "workspace:*",
    "next": "14.2.15",
    "next-intl": "^3.26.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^8.0.7",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^3.0.1",
    "styled-components": "^6.1.13"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.266",
    "@types/node": "^20.11.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/styled-components": "^5.1.34",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.15",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.3",
    "wrangler": "^3.86.0"
  }
}
