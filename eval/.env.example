# Anthropic API key for the agent backbone (sonnet-4-6 or opus-4-7).
ANTHROPIC_API_KEY=sk-ant-...

# WebArena service URLs. After `docker compose up -d` in docker/, these will
# point at your local instances. The official WebArena docker images expose
# fixed ports — keep these defaults unless you changed the compose file.
SHOPPING=http://localhost:7770
SHOPPING_ADMIN=http://localhost:7780
REDDIT=http://localhost:9999
GITLAB=http://localhost:8023
WIKIPEDIA=http://localhost:8888
MAP=http://localhost:3000
HOMEPAGE=http://localhost:4399

# Optional — used only by the runner to tag rows in runs.csv with the renderer
# version they were captured against. If unset the runner reads
# `skill-render --version` directly.
# SKILL_RENDER_VERSION=0.1.1
