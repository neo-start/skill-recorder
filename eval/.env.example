# Anthropic API key for the agent backbone (sonnet-4-6 / opus-4-7 / haiku-4-5).
ANTHROPIC_API_KEY=sk-ant-...

# WebArena service URLs (REQUIRED by browsergym-webarena).
#
# browsergym-webarena asserts that ALL seven WA_* env vars are set on import,
# even if you only use one service. For services you DIDN'T bring up via
# docker/setup-webarena.sh, point at a dummy URL — tasks targeting those
# services will fail when the agent tries to reach them, but the import won't.
#
# Our MVP scope is shopping_admin only — the others below are intentionally
# dummies. Replace with real localhost URLs if you opt those services in
# (set WEBARENA_<SERVICE>=1 when running setup-webarena.sh).

WA_SHOPPING_ADMIN=http://localhost:7780/admin

# Dummies for services we're not running (browsergym needs them to exist).
WA_SHOPPING=http://localhost:7770
WA_REDDIT=http://localhost:9999
WA_GITLAB=http://localhost:8023
WA_WIKIPEDIA=http://localhost:8888
WA_MAP=http://localhost:3000
WA_HOMEPAGE=http://localhost:4399

# Optional: pin renderer build for reproducibility. Without this the runner
# reads `skill-render --version` directly.
# SKILL_RENDER_VERSION=0.1.1
